{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opencanvas-tunnel-remote-test",
  "main": "cloudflare/tunnel-proxy.js",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "FACETWRITE_TUNNEL_API_ORIGIN": "https://replace-with-your-tunnel-host"
  }
}
