OPENAI_PROVIDER_ID=deepseek
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_API_KEY=replace-with-your-local-key
AGENT_SYSTEM_PROMPT="You are FacetWrite's text agent. Use the AgentCard, Skill, structured inputs, context, and tool state to produce clear, editable, collaborative text."

DEERFLOW_ENABLED=false
DEERFLOW_BASE_URL=http://127.0.0.1:2026
DEERFLOW_ASSISTANT_ID=lead_agent
DEERFLOW_AUTH_EMAIL=admin@example.com
DEERFLOW_AUTH_PASSWORD=replace-with-local-deerflow-password
DEERFLOW_AUTO_SETUP=false
DEERFLOW_AUTH_TIMEOUT_MS=5000
