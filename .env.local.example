OPENAI_PROVIDER_ID=deepseek
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_API_KEY=replace-with-your-local-key
AGENT_SYSTEM_PROMPT="You are FacetWrite's text agent. Use the AgentCard, Skill, structured inputs, context, and tool state to produce clear, editable, collaborative text."

AGENT_BACKEND_ENABLED=false
AGENT_BACKEND_BASE_URL=http://127.0.0.1:2026
AGENT_BACKEND_ASSISTANT_ID=lead_agent
AGENT_BACKEND_AUTH_EMAIL=admin@example.com
AGENT_BACKEND_AUTH_PASSWORD=replace-with-local-agent-backend-password
AGENT_BACKEND_AUTO_SETUP=false
AGENT_BACKEND_AUTH_TIMEOUT_MS=5000
FACETWRITE_INTERNAL_BASE_URL=http://host.docker.internal:8787
FACETWRITE_INTERNAL_TOOL_TOKEN=replace-with-optional-bridge-token
