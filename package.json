{
  "name": "facetwrite-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-facetwrite.ps1",
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "tsx watch server/index.ts",
    "deerflow:up": "docker compose -p deer-flow-dev -f Deerflow/docker/docker-compose-dev.yaml up -d nginx frontend gateway",
    "deerflow:down": "docker compose -p deer-flow-dev -f Deerflow/docker/docker-compose-dev.yaml down",
    "deerflow:status": "docker ps --filter name=deer-flow --format \"table {{.Names}}\\t{{.Status}}\\t{{.Ports}}\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --import tsx --test server/**/*.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^1.16.0",
    "openai": "^6.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
